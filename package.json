{
  "name": "gharpata-mern",
  "version": "1.0.0",
  "private": true,
  "description": "Smart House Rental Management System for Nepal - MERN Stack with SQL",
  "keywords": [
    "rental",
    "housing",
    "nepal",
    "mern",
    "property-management",
    "mysql"
  ],
  "license": "MIT",
  "author": "Abhishekh Kunwar",
  "scripts": {
    "install-all": "npm install && cd Backend && npm install && cd ../Frontend && npm install",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd Backend && nodemon server.js",
    "dev:client": "cd Frontend && npm run dev",
    "start": "npm run dev:server",
    "build": "cd Frontend && npm run build"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
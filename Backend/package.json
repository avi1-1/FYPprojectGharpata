        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "google-auth-library": "^10.5.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^2.0.2",
        "mysql2": "^3.6.5",
        "nodemailer": "^8.0.2"
    },
    "devDependencies": {
        "jest": "^30.4.2",
        "nodemon": "^3.0.2",
        "supertest": "^7.2.2"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": ["**/tests/**/*.test.js"],
        "setupFiles": ["./tests/setup.js"]

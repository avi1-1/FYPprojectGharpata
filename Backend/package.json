    "description": "GharPata Backend - Express + MySQL",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "test": "jest --forceExit --detectOpenHandles"
    },
    "dependencies": {
        "axios": "^1.13.2",
